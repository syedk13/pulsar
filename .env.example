# Copy to .env (repo root) and fill in. Never commit .env.
# Both apps/web (Vite envDir) and apps/api (pydantic-settings) read the root .env.

# --- Frontend (exposed to the browser — public values ONLY) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_API_BASE_URL=http://localhost:8000

# --- API (server-side only — never prefix these with VITE_) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEMO_MODE=true
