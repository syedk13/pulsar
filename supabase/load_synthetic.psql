-- Load the synthetic dataset into Supabase (or any Postgres with all migrations applied).
-- Run from the repo root, after `npm run synth`:
--   psql "$DATABASE_URL" -f supabase/load_synthetic.psql
-- Safe to re-run after regenerating (the generator's ids are deterministic).
-- Everything runs in one transaction, so readers never see a partial load.
--
-- What it replaces: generated rows only (source = 'synthetic').
-- What it keeps:    the fictional profiles themselves (updated in place), their linked
--                   Supabase Auth accounts (crew_profiles.user_id), and any check-ins
--                   entered through the app (source <> 'synthetic').

\set ON_ERROR_STOP on

begin;

-- 1. Profiles: update in place so linked accounts and form check-ins stay attached.
create temp table _crew_profiles (like public.crew_profiles including defaults) on commit drop;
\copy _crew_profiles (id, user_id, profile_code, display_name, mission_label, baseline_metadata, is_fictional) from 'apps/api/app/synthetic/out/crew_profiles.csv' with (format csv, header true)

insert into public.crew_profiles (id, profile_code, display_name, mission_label, baseline_metadata, is_fictional)
select id, profile_code, display_name, mission_label, baseline_metadata, is_fictional
from _crew_profiles
on conflict (id) do update set
  profile_code      = excluded.profile_code,
  display_name      = excluded.display_name,
  mission_label     = excluded.mission_label,
  baseline_metadata = excluded.baseline_metadata,
  is_fictional      = excluded.is_fictional,
  updated_at        = now();
-- user_id is never overwritten here.

-- 2. Replace generated rows only.
delete from public.health_checkins      where source = 'synthetic';
delete from public.environment_readings where source = 'synthetic';
delete from public.mission_events       where source = 'synthetic';

\copy public.health_checkins (id, profile_id, recorded_at, sleep_duration_hours, mood_rating, resting_heart_rate, source, is_simulated, data_quality) from 'apps/api/app/synthetic/out/health_checkins.csv' with (format csv, header true)
\copy public.environment_readings (id, recorded_at, source, instrument, measurement_type, value, unit, location_context, is_simulated, is_stale, source_retrieved_at, metadata) from 'apps/api/app/synthetic/out/environment_readings.csv' with (format csv, header true)
\copy public.mission_events (id, event_type, level, start_time, end_time, source, source_event_id, link, is_simulated, metadata) from 'apps/api/app/synthetic/out/mission_events.csv' with (format csv, header true)

commit;

-- Row counts. The first four should match synthetic_manifest.json "row_counts".
select 'crew_profiles' as table_name, count(*) from public.crew_profiles where is_fictional
union all select 'health_checkins', count(*) from public.health_checkins where source = 'synthetic'
union all select 'environment_readings', count(*) from public.environment_readings where source = 'synthetic'
union all select 'mission_events', count(*) from public.mission_events where source = 'synthetic'
union all select 'linked_profiles', count(*) from public.crew_profiles where is_fictional and user_id is not null
union all select 'form_checkins_kept', count(*) from public.health_checkins where source <> 'synthetic';
